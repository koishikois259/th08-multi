; Copy this file to th08_multi.ini next to th08-multi.exe.
; Both peers must use the same build. Each player chooses a team in the
; in-game character-select screen after the connection is established.

[network]
; disabled, host, guest, or local (the launcher writes local mode automatically)
mode=disabled
; The launcher manages this automatically and listens on all local IPv4 interfaces.
bind_address=0.0.0.0
host=127.0.0.1
host_port=17708
; Host uses 17708. Guest should change this to 0 (automatic local port).
local_port=17708
input_delay=3
